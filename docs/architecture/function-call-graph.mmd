flowchart TD
  Entry["main(argc, argv)"]
  Parse["parseOptions"]
  Read["InstanceReader::readInstance"]
  Resolve["resolveInputPath"]
  Json["json::parseFile / Parser::parse"]
  ParseFields["polygon / point"]
  Model["populate Problem"]
  ProblemCheck["Problem::validate"]
  Raster["Problem::regionCells / cutterCells"]
  Dispatch["hard-coded conditional dispatch"]
  VirtualSolve["algorithm->solve(timeout)\nvirtual target inferred from selected concrete object"]
  FinalCheck["Solution::validate"]
  Covered["Problem::isCovered(tours)"]
  Write["SolutionWriter::write"]
  ReadCandidate["SolutionReader::readSolution\nused by tests and candidate consumers"]

  Entry -->|"direct"| Parse
  Entry -->|"direct"| Read
  Entry -->|"direct only for local initializer"| Partition
  Read -->|"direct"| Resolve
  Read -->|"direct"| Json
  Json -->|"direct through parser routines"| ParseFields
  Read -->|"direct"| ParseFields
  ParseFields -->|"returns parsed coordinates"| Model
  Read -->|"direct after model population"| ProblemCheck
  Entry -->|"direct"| Dispatch
  Dispatch -. "virtual target inferred from concrete construction in main.cpp" .-> VirtualSolve
  Entry -->|"direct final gate"| FinalCheck
  VirtualSolve -->|"returns candidate"| FinalCheck
  FinalCheck -->|"direct"| ProblemCheck
  FinalCheck -->|"direct"| Covered
  ProblemCheck -->|"direct"| Raster
  Covered -->|"direct"| Raster
  Entry -->|"direct only after check succeeds"| Write
  ReadCandidate -->|"direct"| Json
  ReadCandidate -->|"direct"| FinalCheck
  Write -->|"direct validation before serialization"| FinalCheck

